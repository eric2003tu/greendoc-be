# Copy to .env (git-ignored) and fill in. On Render, upload it as a Secret File named .env.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GREENDOC_S3_BUCKET=greendoc-installers
GREENDOC_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
GREENDOC_S3_KEY_ID=
GREENDOC_S3_SECRET=
GREENDOC_ADMIN_EMAIL=
GREENDOC_ADMIN_PASSWORD=
GREENDOC_FRONTEND_URL=
